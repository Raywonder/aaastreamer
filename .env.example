AAASTREAMER_PORT=8095
AAASTREAMER_PUBLIC_URL=https://streaming.example.com
AAASTREAMER_MASTER_URL=https://aaastreamer.devinecreations.net
AAASTREAMER_RELEASE_BASE_URL=https://git.tappedin.fm/raywonder/aaastreamer/releases
AAASTREAMER_UPDATE_MANIFEST_URL=https://git.tappedin.fm/raywonder/aaastreamer/releases/latest/download/update-manifest.json
AAASTREAMER_PRIMARY_DOMAINS=*.voicelinkapp.app,*.voicelinkapp.dev,*.tappedin.fm
AAASTREAMER_REQUIRE_SECRET=false
VOICELINK_API_URL=https://voicelinkapp.app
VOICELINK_SHARED_SECRET=replace-me
RTMP_APP_NAME=live
HLS_PATH=/tmp/hls
RECORDINGS_PATH=/tmp/recordings
ALLOW_RESTREAM=true
AAASTREAMER_ALLOW_AD_HOC_STREAMS=false
AAASTREAMER_ADMIN_USER=admin
AAASTREAMER_ADMIN_PASSWORD=change-this-before-first-run
AAASTREAMER_SITE_NAME=AAAStreamer
AAASTREAMER_RTMP_HOST=streaming.example.com
AAASTREAMER_HLS_BASE_URL=https://streaming.example.com
AAASTREAMER_REGISTRATION_ENABLED=false
# This must be the exact public origin that receives the OAuth callbacks.
AAASTREAMER_AUTH_BASE_URL=https://streaming.example.com
# Use mastodon.devinecreations.net for aaastreamer.devinecreations.net and
# md.tappedin.fm for TappedIn-hosted installs. Add only exact HTTPS issuers that
# this operator trusts. Keep every clientSecret in this server-side file.
AAASTREAMER_MASTODON_AUTH_PROVIDERS_JSON=[{"issuer":"https://mastodon.devinecreations.net","clientId":"replace-me","clientSecret":"replace-me","label":"Devine Creations Mastodon"},{"issuer":"https://md.tappedin.fm","clientId":"replace-me","clientSecret":"replace-me","label":"TappedIn Mastodon"}]
# At least 32 random characters. Required before storing a user's revocable Mastodon posting authorization.
AAASTREAMER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional browser publishing. Leave blank to hide browser go-live controls.
# The URL must be the public TLS-protected MediaMTX WHIP endpoint.
AAASTREAMER_WHIP_PUBLIC_URL=
# Shown in the configurable stream-page footer when the website link is enabled.
AAASTREAMER_HOST_WEBSITE_URL=https://example.com
AAASTREAMER_WORDPRESS_CONNECTOR_PACKAGE_URL=https://git.tappedin.fm/raywonder/aaastreamer/releases/latest/download/aaastreamer-connector.zip
AAASTREAMER_UPLOAD_LIMIT=75mb
AAASTREAMER_MAX_UPLOAD_BYTES=78643200
AAASTREAMER_MAX_BULK_UPLOADS=12
AAASTREAMER_DATA_DIR=/var/lib/aaastreamer
AAASTREAMER_UPLOAD_FOLDER=/var/lib/aaastreamer/uploads
# Semicolon-separated. Format: label|path|enabled|visible|audio|video
AAASTREAMER_MEDIA_FOLDERS=Server media|/var/lib/aaastreamer/media|enabled|visible|audio|video
AAASTREAMER_WHMCS_URL=https://devine-creations.com
AAASTREAMER_WHMCS_DEFAULT_CLIENT_ID=
AAASTREAMER_WHMCS_PAYMENT_METHOD=
AAASTREAMER_WHMCS_API_IDENTIFIER=replace-with-whmcs-api-identifier
AAASTREAMER_WHMCS_API_SECRET=replace-with-whmcs-api-secret
AAASTREAMER_WHMCS_API_ACCESS_KEY=
AAASTREAMER_STRIPE_SECRET_KEY=sk_live_or_test_replace_me
AAASTREAMER_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# This separate token is for server-side timeline sharing, not user login.
AAASTREAMER_MASTODON_INSTANCE_URL=https://md.tappedin.fm
AAASTREAMER_MASTODON_ACCESS_TOKEN=
